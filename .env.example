# NEXT.js & SUPABASE CONFIGURATION
# Obtén estas credenciales en https://supabase.com -> Project Settings -> API

# URL pública de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (usada en navegador y llamadas autenticadas con sesión de usuario)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role (SÓLO para el backend / servidor. NUNCA exponer en NEXT_PUBLIC_*)
# Usada para validar registros rápidos de estudiantes o bypass controlado de RLS en endpoints seguros.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base de tu aplicación (para generación de enlaces QR y redirecciones)
# En local: http://localhost:3000
# En producción Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nombre institucional mostrado en la interfaz
NEXT_PUBLIC_SCHOOL_NAME=Nombre del colegio
