# NEXT.js & SUPABASE CONFIGURATION
# Obtén estas credenciales en https://supabase.com -> Project Settings -> API

# URL pública de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (usada en navegador y llamadas autenticadas con sesión de usuario)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave Service Role (SÓLO para el backend / servidor. NUNCA exponer en NEXT_PUBLIC_*)
# Se usa únicamente en los endpoints públicos de registro QR y consulta de sesión.
# Las rutas administrativas usan la sesión del usuario para que RLS aplique.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL base de tu aplicación (para generación de enlaces QR y redirecciones)
# En local: http://localhost:3000
# En producción Vercel: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sólo durante pruebas. false antes de cargar datos reales; requiere redesplegar.
# Habilita el borrado global de sesiones/asistencias/incidencias sólo para admin.
ENABLE_TEST_CLEANUP=false

# Credenciales opcionales para `npm run verify:rls` (sólo lectura).
# RLS_TEACHER_A_EMAIL=
# RLS_TEACHER_A_PASSWORD=
# RLS_TEACHER_B_EMAIL=
# RLS_TEACHER_B_PASSWORD=
# RLS_ADMIN_EMAIL=
# RLS_ADMIN_PASSWORD=
